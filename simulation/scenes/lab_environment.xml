<mujocoinclude>
  <!--
    LabMate laboratory environment. Included by labmate_scene.xml AFTER K1_22dof.xml.
    Units: metres. Origin: robot start point on the floor. +X into the room, +Y left (north), +Z up.
    Adds only static bodies. No ground plane, lights, joints, actuators, options or global defaults.
  -->
  <default>
    <default class="lab_vis">
      <geom group="2" contype="0" conaffinity="0" density="0"/>
    </default>
    <default class="lab_col">
      <geom group="3" contype="1" conaffinity="1" density="0" rgba="0.9 0.2 0.2 0.3"/>
    </default>
  </default>

  <asset>
    <material name="mat_floor" rgba="0.50 0.52 0.55 1" specular="0.1" shininess="0.15"/>
    <material name="mat_wall" rgba="0.88 0.89 0.87 1" specular="0.05" shininess="0.1"/>
    <material name="mat_trim" rgba="0.28 0.31 0.35 1" specular="0.1" shininess="0.2"/>
    <material name="mat_accent" rgba="0.05 0.42 0.52 1" specular="0.3" shininess="0.4"/>
    <material name="mat_bench_top" rgba="0.30 0.33 0.37 1" specular="0.3" shininess="0.4"/>
    <material name="mat_wood" rgba="0.62 0.45 0.28 1" specular="0.1" shininess="0.2"/>
    <material name="mat_frame" rgba="0.55 0.58 0.62 1" specular="0.5" shininess="0.5"/>
    <material name="mat_instrument" rgba="0.80 0.79 0.73 1" specular="0.2" shininess="0.3"/>
    <material name="mat_instrument_dark" rgba="0.18 0.20 0.23 1" specular="0.3" shininess="0.4"/>
    <material name="mat_dark" rgba="0.07 0.07 0.08 1" specular="0.2" shininess="0.3"/>
    <material name="mat_screen" rgba="0.10 0.45 0.70 1" specular="0.5" shininess="0.6" emission="0.6"/>
    <material name="mat_screen_green" rgba="0.15 0.90 0.40 1" specular="0.1" shininess="0.1" emission="0.6"/>
    <material name="mat_esd" rgba="0.12 0.30 0.50 1" specular="0.05" shininess="0.1"/>
    <material name="mat_pcb" rgba="0.04 0.40 0.18 1" specular="0.2" shininess="0.3"/>
    <material name="mat_pegboard" rgba="0.55 0.47 0.34 1" specular="0.05" shininess="0.1"/>
    <material name="mat_rack" rgba="0.10 0.11 0.13 1" specular="0.4" shininess="0.4"/>
    <material name="mat_red" rgba="0.78 0.08 0.06 1" specular="0.3" shininess="0.4"/>
    <material name="mat_marking_yellow" rgba="0.95 0.72 0.05 1" specular="0.1" shininess="0.2"/>
    <material name="mat_marking_blue" rgba="0.05 0.35 0.85 1" specular="0.1" shininess="0.2"/>
    <material name="mat_bin_blue" rgba="0.13 0.30 0.58 1" specular="0.1" shininess="0.2"/>
    <material name="mat_bin_grey" rgba="0.45 0.48 0.52 1" specular="0.2" shininess="0.3"/>
    <material name="mat_cardboard" rgba="0.60 0.46 0.28 1" specular="0" shininess="0"/>
    <!-- Inspection-station materials. mat_screen_green / mat_red carry "nominal"
         and "fault" on every indicator, so one material swap sets a station's
         state; see shared/scenario.py. -->
    <material name="mat_glass" rgba="0.62 0.78 0.84 0.35" specular="0.6" shininess="0.7"/>
    <material name="mat_amber" rgba="0.95 0.55 0.05 1" specular="0.3" shininess="0.4" emission="0.4"/>
    <material name="mat_safety_green" rgba="0.05 0.45 0.22 1" specular="0.1" shininess="0.2"/>
    <material name="mat_chem_yellow" rgba="0.92 0.74 0.08 1" specular="0.15" shininess="0.25"/>
    <material name="mat_steel" rgba="0.72 0.74 0.76 1" specular="0.6" shininess="0.6"/>
  </asset>

  <worldbody>
    <!-- Visual only floor skin 1 mm above the K1 ground plane. Physics stays on the original "ground" geom. -->
    <body name="lab_floor">
      <geom name="floor_skin" class="lab_vis" type="box" pos="3 0 0.0005" size="4 3 0.0005" material="mat_floor"/>
      <geom name="start_pad" class="lab_vis" type="box" pos="0 0 0.00125" size="0.3 0.3 0.00025" material="mat_marking_blue"/>
      <geom name="start_arrow" class="lab_vis" type="box" pos="0.41 0 0.00125" size="0.09 0.03 0.00025" material="mat_marking_blue"/>
      <geom name="mark_electronics_a" class="lab_vis" type="box" pos="1.6 2.06 0.00125" size="0.35 0.03 0.00025" material="mat_marking_yellow"/>
      <geom name="mark_electronics_b" class="lab_vis" type="box" pos="3.8 2.06 0.00125" size="0.35 0.03 0.00025" material="mat_marking_yellow"/>
      <geom name="mark_rack" class="lab_vis" type="box" pos="5.6 2.01 0.00125" size="0.4 0.03 0.00025" material="mat_marking_yellow"/>
      <geom name="mark_robotics" class="lab_vis" type="box" pos="1.8 -2.06 0.00125" size="0.35 0.03 0.00025" material="mat_marking_yellow"/>
      <geom name="mark_printer" class="lab_vis" type="box" pos="3.9 -2.06 0.00125" size="0.35 0.03 0.00025" material="mat_marking_yellow"/>
      <geom name="mark_storage" class="lab_vis" type="box" pos="6.36 0 0.00125" size="0.03 0.35 0.00025" material="mat_marking_yellow"/>
      <geom name="mark_central" class="lab_vis" type="box" pos="2.01 0 0.00125" size="0.03 0.35 0.00025" material="mat_marking_yellow"/>
    </body>

    <!-- Room shell. Interior X -1..7, Y -3..3. Wall thickness 0.10. North/east drawn 2.8 m, south/west cut away to 1.0 m for the viewer; all collide to 2.8 m. -->
    <body name="lab_walls">
      <geom name="wall_north" class="lab_vis" type="box" pos="3 3.05 1.4" size="4.1 0.05 1.4" material="mat_wall"/>
      <geom name="col_wall_north" class="lab_col" type="box" pos="3 3.05 1.4" size="4.1 0.05 1.4"/>
      <geom name="skirt_north" class="lab_vis" type="box" pos="3 3.05 0.06" size="4.1 0.055 0.06" material="mat_trim"/>
      <geom name="wall_south" class="lab_vis" type="box" pos="3 -3.05 0.5" size="4.1 0.05 0.5" material="mat_wall"/>
      <geom name="col_wall_south" class="lab_col" type="box" pos="3 -3.05 1.4" size="4.1 0.05 1.4"/>
      <geom name="skirt_south" class="lab_vis" type="box" pos="3 -3.05 0.06" size="4.1 0.055 0.06" material="mat_trim"/>
      <geom name="wall_east" class="lab_vis" type="box" pos="7.05 0 1.4" size="0.05 3 1.4" material="mat_wall"/>
      <geom name="col_wall_east" class="lab_col" type="box" pos="7.05 0 1.4" size="0.05 3 1.4"/>
      <geom name="skirt_east" class="lab_vis" type="box" pos="7.05 0 0.06" size="0.055 3 0.06" material="mat_trim"/>
      <geom name="wall_west_n" class="lab_vis" type="box" pos="-1.05 1.85 0.5" size="0.05 1.15 0.5" material="mat_wall"/>
      <geom name="col_wall_west_n" class="lab_col" type="box" pos="-1.05 1.85 1.4" size="0.05 1.15 1.4"/>
      <geom name="skirt_west_n" class="lab_vis" type="box" pos="-1.05 1.85 0.06" size="0.055 1.15 0.06" material="mat_trim"/>
      <geom name="wall_west_s" class="lab_vis" type="box" pos="-1.05 -1.85 0.5" size="0.05 1.15 0.5" material="mat_wall"/>
      <geom name="col_wall_west_s" class="lab_col" type="box" pos="-1.05 -1.85 1.4" size="0.05 1.15 1.4"/>
      <geom name="skirt_west_s" class="lab_vis" type="box" pos="-1.05 -1.85 0.06" size="0.055 1.15 0.06" material="mat_trim"/>
    </body>

    <!-- Entrance in the west wall: clear opening 1.40 wide x 2.10 high, centred on y=0. Door is modelled as absent (open). -->
    <body name="lab_entrance">
      <geom name="door_post_n" class="lab_vis" type="box" pos="-1.05 0.74 1.09" size="0.07 0.04 1.09" material="mat_accent"/>
      <geom name="col_door_post_n" class="lab_col" type="box" pos="-1.05 0.74 1.09" size="0.07 0.04 1.09"/>
      <geom name="door_post_s" class="lab_vis" type="box" pos="-1.05 -0.74 1.09" size="0.07 0.04 1.09" material="mat_accent"/>
      <geom name="col_door_post_s" class="lab_col" type="box" pos="-1.05 -0.74 1.09" size="0.07 0.04 1.09"/>
      <geom name="door_lintel" class="lab_vis" type="box" pos="-1.05 0 2.14" size="0.07 0.78 0.04" material="mat_accent"/>
      <geom name="col_door_lintel" class="lab_col" type="box" pos="-1.05 0 2.14" size="0.07 0.78 0.04"/>
    </body>

    <!--
      INSPECTION STATION 1 - Emergency eyewash and safety shower.
      Viewed from inspect_electronics_a (1.6, 1.6) facing +Y.
      Standard: ANSI/ISEA Z358.1 - plumbed units activated weekly, inspected annually.
      Checked: access to the unit is clear, and the inspection tag is current.
      State geoms: eyewash_tag (material), eyewash_obstruction (visibility).
      The bench and its collision box are unchanged; only the bench-top fittings differ.
    -->
    <body name="electronics_bench_a">
      <geom name="ebench_a_top" class="lab_vis" type="box" pos="1.6 2.625 0.73" size="0.9 0.375 0.02" material="mat_bench_top"/>
      <geom name="ebench_a_leg0" class="lab_vis" type="box" pos="0.75 2.3 0.355" size="0.025 0.025 0.355" material="mat_frame"/>
      <geom name="ebench_a_leg1" class="lab_vis" type="box" pos="2.45 2.3 0.355" size="0.025 0.025 0.355" material="mat_frame"/>
      <geom name="ebench_a_leg2" class="lab_vis" type="box" pos="0.75 2.95 0.355" size="0.025 0.025 0.355" material="mat_frame"/>
      <geom name="ebench_a_leg3" class="lab_vis" type="box" pos="2.45 2.95 0.355" size="0.025 0.025 0.355" material="mat_frame"/>
      <geom name="ebench_a_shelf" class="lab_vis" type="box" pos="1.6 2.625 0.235" size="0.82 0.295 0.015" material="mat_frame"/>
      <geom name="col_ebench_a" class="lab_col" type="box" pos="1.6 2.625 0.375" size="0.9 0.375 0.375"/>
      <!-- Eyewash unit: basin, dual spray heads, push paddle. -->
      <geom name="eyewash_basin" class="lab_vis" type="cylinder" pos="1.6 2.63 0.775" size="0.19 0.025" material="mat_steel"/>
      <geom name="eyewash_bowl" class="lab_vis" type="cylinder" pos="1.6 2.63 0.805" size="0.165 0.02" material="mat_frame"/>
      <geom name="eyewash_post" class="lab_vis" type="cylinder" pos="1.6 2.72 0.90" size="0.022 0.10" material="mat_steel"/>
      <geom name="eyewash_yoke" class="lab_vis" type="box" pos="1.6 2.70 1.00" size="0.10 0.018 0.016" material="mat_steel"/>
      <geom name="eyewash_head_l" class="lab_vis" type="cylinder" pos="1.50 2.70 1.025" size="0.042 0.022" material="mat_safety_green"/>
      <geom name="eyewash_head_r" class="lab_vis" type="cylinder" pos="1.70 2.70 1.025" size="0.042 0.022" material="mat_safety_green"/>
      <geom name="eyewash_paddle" class="lab_vis" type="box" pos="1.6 2.44 0.95" size="0.095 0.011 0.045" material="mat_safety_green"/>
      <geom name="eyewash_paddle_arm" class="lab_vis" type="box" pos="1.6 2.555 0.95" size="0.012 0.105 0.012" material="mat_steel"/>
      <!-- Overhead drench shower, wall mounted above the unit. -->
      <geom name="shower_pipe" class="lab_vis" type="cylinder" pos="1.6 2.93 1.60" size="0.022 0.44" material="mat_steel"/>
      <geom name="shower_arm" class="lab_vis" type="cylinder" pos="1.6 2.76 2.03" size="0.022 0.17" quat="0.7071068 0.7071068 0 0" material="mat_steel"/>
      <geom name="shower_head" class="lab_vis" type="cylinder" pos="1.6 2.60 1.98" size="0.145 0.025" material="mat_safety_green"/>
      <geom name="shower_handle" class="lab_vis" type="box" pos="1.6 2.60 1.72" size="0.012 0.012 0.21" material="mat_steel"/>
      <geom name="shower_ring" class="lab_vis" type="cylinder" pos="1.6 2.60 1.50" size="0.07 0.012" material="mat_safety_green"/>
      <!-- Statutory signage, and the weekly-activation tag the robot reads.
           mat_screen_green = tag current. mat_red = overdue. -->
      <geom name="eyewash_sign" class="lab_vis" type="box" pos="1.6 2.975 1.32" size="0.19 0.008 0.145" material="mat_safety_green"/>
      <geom name="eyewash_sign_cross_v" class="lab_vis" type="box" pos="1.6 2.966 1.32" size="0.035 0.004 0.10" material="mat_wall"/>
      <geom name="eyewash_sign_cross_h" class="lab_vis" type="box" pos="1.6 2.966 1.32" size="0.115 0.004 0.034" material="mat_wall"/>
      <geom name="eyewash_tag" class="lab_vis" type="box" pos="1.93 2.44 0.90" size="0.055 0.004 0.075" material="mat_screen_green"/>
      <geom name="eyewash_tag_clip" class="lab_vis" type="box" pos="1.93 2.44 0.985" size="0.012 0.008 0.012" material="mat_dark"/>
      <!-- Floor keep-clear zone, then the obstruction that violates it.
           eyewash_obstruction is hidden in the nominal scenario. Visual only:
           the robot must see and report it, not collide with it. -->
      <geom name="eyewash_keepclear" class="lab_vis" type="box" pos="1.6 2.12 0.00175" size="0.55 0.14 0.00025" material="mat_marking_yellow"/>
      <geom name="eyewash_obstruction" class="lab_vis" type="box" pos="1.60 2.14 0.20" size="0.28 0.19 0.20" material="mat_cardboard"/>
      <geom name="eyewash_obstruction_tape" class="lab_vis" type="box" pos="1.60 2.14 0.28" size="0.282 0.192 0.022" material="mat_wood"/>
    </body>

    <!--
      INSPECTION STATION 2 - Chemical fume hood.
      Viewed from inspect_electronics_b (3.8, 1.6) facing +Y.
      Standard: ASHRAE 110 containment; sash discipline is institutional policy.
      Checked: the sash is down. An open sash is both a containment breach and
      the largest single energy cost in a laboratory (measured interventions
      report ~$1,159-$1,300 per hood per year from closing sashes alone).
      State geoms: hood_sash (z position), hood_flow_led (material).
      The bench and its collision box are unchanged.
    -->
    <body name="electronics_bench_b">
      <geom name="ebench_b_top" class="lab_vis" type="box" pos="3.8 2.625 0.73" size="0.9 0.375 0.02" material="mat_bench_top"/>
      <geom name="ebench_b_leg0" class="lab_vis" type="box" pos="2.95 2.3 0.355" size="0.025 0.025 0.355" material="mat_frame"/>
      <geom name="ebench_b_leg1" class="lab_vis" type="box" pos="4.65 2.3 0.355" size="0.025 0.025 0.355" material="mat_frame"/>
      <geom name="ebench_b_leg2" class="lab_vis" type="box" pos="2.95 2.95 0.355" size="0.025 0.025 0.355" material="mat_frame"/>
      <geom name="ebench_b_leg3" class="lab_vis" type="box" pos="4.65 2.95 0.355" size="0.025 0.025 0.355" material="mat_frame"/>
      <geom name="ebench_b_shelf" class="lab_vis" type="box" pos="3.8 2.625 0.235" size="0.82 0.295 0.015" material="mat_frame"/>
      <geom name="col_ebench_b" class="lab_col" type="box" pos="3.8 2.625 0.375" size="0.9 0.375 0.375"/>
      <!-- Hood enclosure. Working deck at z=0.79, soffit at z=1.845, so the
           face opening is 1.055 m tall and 1.70 m wide. -->
      <geom name="hood_deck" class="lab_vis" type="box" pos="3.8 2.65 0.772" size="0.85 0.345 0.022" material="mat_instrument_dark"/>
      <geom name="hood_side_l" class="lab_vis" type="box" pos="2.925 2.65 1.315" size="0.025 0.345 0.525" material="mat_instrument"/>
      <geom name="hood_side_r" class="lab_vis" type="box" pos="4.675 2.65 1.315" size="0.025 0.345 0.525" material="mat_instrument"/>
      <geom name="hood_back" class="lab_vis" type="box" pos="3.8 2.975 1.315" size="0.85 0.02 0.525" material="mat_instrument"/>
      <geom name="hood_baffle" class="lab_vis" type="box" pos="3.8 2.94 1.74" size="0.84 0.015 0.09" material="mat_instrument_dark"/>
      <geom name="hood_soffit" class="lab_vis" type="box" pos="3.8 2.65 1.862" size="0.875 0.37 0.018" material="mat_instrument"/>
      <geom name="hood_duct" class="lab_vis" type="cylinder" pos="3.8 2.80 2.08" size="0.105 0.20" material="mat_frame"/>
      <!-- Sash. mat_glass so the deck stays visible through it.
           z=1.317 is fully down (spans the whole opening);
           z=1.667 is raised, leaving a 0.35 m gap at the deck. -->
      <geom name="hood_sash" class="lab_vis" type="box" pos="3.8 2.315 1.317" size="0.845 0.012 0.527" material="mat_glass"/>
      <geom name="hood_sash_handle" class="lab_vis" type="box" pos="3.8 2.30 0.825" size="0.30 0.018 0.022" material="mat_steel"/>
      <geom name="hood_sash_rail_l" class="lab_vis" type="box" pos="2.925 2.315 1.315" size="0.022 0.028 0.53" material="mat_frame"/>
      <geom name="hood_sash_rail_r" class="lab_vis" type="box" pos="4.675 2.315 1.315" size="0.022 0.028 0.53" material="mat_frame"/>
      <!-- Airflow monitor. mat_screen_green = face velocity in range,
           mat_red = alarm (what an open sash produces on a real monitor). -->
      <geom name="hood_monitor" class="lab_vis" type="box" pos="4.46 2.28 1.72" size="0.11 0.032 0.085" material="mat_instrument_dark"/>
      <geom name="hood_flow_led" class="lab_vis" type="box" pos="4.46 2.245 1.735" size="0.075 0.004 0.042" material="mat_screen_green"/>
      <geom name="hood_flow_btn" class="lab_vis" type="box" pos="4.46 2.245 1.655" size="0.022 0.004 0.014" material="mat_dark"/>
      <geom name="hood_label" class="lab_vis" type="box" pos="3.25 2.28 1.72" size="0.20 0.006 0.075" material="mat_marking_yellow"/>
      <!-- Contents of the hood, so an open sash reads as a live hazard. -->
      <geom name="hood_beaker" class="lab_vis" type="cylinder" pos="3.60 2.72 0.862" size="0.058 0.068" material="mat_glass"/>
      <geom name="hood_beaker_fill" class="lab_vis" type="cylinder" pos="3.60 2.72 0.828" size="0.051 0.032" material="mat_amber"/>
      <geom name="hood_flask" class="lab_vis" type="cylinder" pos="3.95 2.76 0.845" size="0.045 0.051" material="mat_glass"/>
      <geom name="hood_stand" class="lab_vis" type="box" pos="4.25 2.80 0.80" size="0.075 0.075 0.006" material="mat_dark"/>
      <geom name="hood_stand_rod" class="lab_vis" type="cylinder" pos="4.29 2.80 0.98" size="0.009 0.18" material="mat_steel"/>
    </body>

    <!--
      INSPECTION STATION 3 - Equipment status panel (server / control rack).
      Viewed from inspect_server_rack (5.6, 1.55) facing +Y.
      Checked: all six unit status LEDs are green.
      State geoms: rack_led0 .. rack_led5 (material).
      Geometry unchanged from the original scene.
    -->
    <body name="server_rack">
      <geom name="rack_body" class="lab_vis" type="box" pos="5.6 2.6 0.8" size="0.35 0.4 0.8" material="mat_rack"/>
      <geom name="rack_unit0" class="lab_vis" type="box" pos="5.6 2.195 0.285" size="0.3 0.005 0.085" material="mat_instrument_dark"/>
      <geom name="rack_led0" class="lab_vis" type="box" pos="5.36 2.188 0.28" size="0.02 0.002 0.02" material="mat_screen_green"/>
      <geom name="rack_unit1" class="lab_vis" type="box" pos="5.6 2.195 0.505" size="0.3 0.005 0.085" material="mat_instrument_dark"/>
      <geom name="rack_led1" class="lab_vis" type="box" pos="5.36 2.188 0.5" size="0.02 0.002 0.02" material="mat_screen_green"/>
      <geom name="rack_unit2" class="lab_vis" type="box" pos="5.6 2.195 0.725" size="0.3 0.005 0.085" material="mat_instrument_dark"/>
      <geom name="rack_led2" class="lab_vis" type="box" pos="5.36 2.188 0.72" size="0.02 0.002 0.02" material="mat_screen_green"/>
      <geom name="rack_unit3" class="lab_vis" type="box" pos="5.6 2.195 0.945" size="0.3 0.005 0.085" material="mat_instrument_dark"/>
      <geom name="rack_led3" class="lab_vis" type="box" pos="5.36 2.188 0.94" size="0.02 0.002 0.02" material="mat_screen_green"/>
      <geom name="rack_unit4" class="lab_vis" type="box" pos="5.6 2.195 1.165" size="0.3 0.005 0.085" material="mat_instrument_dark"/>
      <geom name="rack_led4" class="lab_vis" type="box" pos="5.36 2.188 1.16" size="0.02 0.002 0.02" material="mat_screen_green"/>
      <geom name="rack_unit5" class="lab_vis" type="box" pos="5.6 2.195 1.385" size="0.3 0.005 0.085" material="mat_instrument_dark"/>
      <geom name="rack_led5" class="lab_vis" type="box" pos="5.36 2.188 1.38" size="0.02 0.002 0.02" material="mat_screen_green"/>
      <geom name="col_server_rack" class="lab_col" type="box" pos="5.6 2.593 0.8" size="0.35 0.407 0.8"/>
    </body>

    <!--
      INSPECTION STATION 5 - Flammables storage cabinet.
      Viewed from inspect_robotics_bench (1.8, -1.6) facing -Y.
      Standard: 29 CFR 1910.1450 (Laboratory Standard); secondary containment.
      Checked: both doors latched, and no liquid outside the containment tray.
      State geoms: chem_door_l / chem_door_r (pose), chem_spill (visibility).
      col_rbench is retained unchanged so the swept route clearances still hold.
      The old bench-top arm's collision box (col_arm) and the monitor's
      (col_monitor_r) are gone with the geometry they belonged to, which only
      removes obstacles - it cannot invalidate a previously cleared route.
    -->
    <body name="robotics_bench">
      <geom name="col_rbench" class="lab_col" type="box" pos="1.8 -2.625 0.375" size="1 0.375 0.375"/>
      <!-- Double cabinet, 2.00 x 0.60 x 1.10, filling the retained collision box. -->
